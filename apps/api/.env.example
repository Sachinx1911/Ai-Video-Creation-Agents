# Copy to apps/api/.env and adjust. Never commit the real .env.
STUDIO_ENV=development
STUDIO_DATABASE_URL=postgresql+psycopg://studio:studio@127.0.0.1:5433/studio
# Default: <repo>/storage
# STUDIO_STORAGE_ROOT=D:/studio-storage
STUDIO_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
STUDIO_FFMPEG_BIN=ffmpeg
STUDIO_FFPROBE_BIN=ffprobe
STUDIO_MAX_UPLOAD_MB=1024
STUDIO_MIN_FREE_DISK_GB=5
STUDIO_LOG_LEVEL=INFO
# Provider API keys are added in Phase 3 (never in source code).
